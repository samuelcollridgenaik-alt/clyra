NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27019/clyra_demo?replicaSet=clyra-dev
JWT_ACCESS_SECRET=replace-with-long-random-secret-at-least-32-characters
JWT_ISSUER=clyra-api
JWT_AUDIENCE=clyra-clients
CORS_ORIGINS=http://localhost:5173
ALLOW_STUDENT_REGISTRATION=false
# Development only: allow written resolution notes (20+ characters) without images.
# Ignored in production; administrator verification remains mandatory.
ALLOW_TEXT_ONLY_RESOLUTION=false
# Seed requires development mode, explicit opt-in and a local clyra_demo database.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
STUDENT_EMAIL_DOMAIN=
AI_BASE_URL=http://127.0.0.1:8000
AI_SHARED_SECRET=replace-with-independent-long-random-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEVICE_ENCRYPTION_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
